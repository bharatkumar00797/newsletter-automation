# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Google AI Studio — used by tools/generate_image_gemini.py for the Nano
# Banana header image on each newsletter issue.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override if Nano Banana's model id has moved again — see the
# comment above DEFAULT_MODEL in tools/generate_image_gemini.py.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
